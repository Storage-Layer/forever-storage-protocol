# Phase 5.4 Cluster Environment Configuration
CLUSTER_ID=fsp-cluster-prod
CLUSTER_INCARNATION=fsp-cluster-prod:1:0
NUM_NODES=20
NUM_ZONES=5
NODES_PER_ZONE=4
BASE_PORT=19000
STORAGE_ROOT_BASE=/var/lib/fsp/nodes
COORDINATOR_ROOT=/var/lib/fsp/coordinator
PKI_DIR=/etc/fsp/pki
LOG_DIR=/var/log/fsp
CAPACITY_BYTES_PER_NODE=107374182400
CODING_SCHEME=RS_20_12
STRIPE_SIZE_BYTES=524288
