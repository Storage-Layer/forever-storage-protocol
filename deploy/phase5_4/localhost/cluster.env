# FSP Localhost Deployment Environment
FSP_BASE_DIR=/var/lib/fsp
FSP_LOG_DIR=/var/log/fsp
FSP_BIN=/usr/local/bin/fsp-node
FSP_TLS_CERT_DIR=/etc/fsp/certs
FSP_COORDINATOR_ADDRS=127.0.0.1:9000,127.0.0.1:9001,127.0.0.1:9002
FSP_TOTAL_NODES=20
FSP_TOTAL_ZONES=5
FSP_NODES_PER_ZONE=4
FSP_BASE_PORT=9100
FSP_BASE_METRICS_PORT=9200
FSP_GC_INTERVAL_SECS=300
FSP_HEARTBEAT_SECS=5
FSP_LEASE_EXPIRY_SECS=15
